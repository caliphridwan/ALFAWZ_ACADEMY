// AlFawz Academy — database schema
// Mirrors Section 40 of the project spec, plus the tables NextAuth needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  STUDENT
  SPONSOR
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// How an enrollment became ACTIVE. PAYSTACK is the normal self-serve flow.
// The other two are admin-recorded (Section: admin adds students directly)
// — OFFLINE_PAYMENT still creates a real Payment row (counts as revenue,
// money genuinely changed hands, just not through Paystack); SCHOLARSHIP
// creates no Payment row at all, so it never inflates revenue totals.
enum EnrollmentSource {
  PAYSTACK
  SCHOLARSHIP
  OFFLINE_PAYMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExamResult {
  PASSED
  FAILED
}

enum PaymentType {
  COURSE
  SPONSORSHIP
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum SponsorshipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AlumniStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

// ---------- NextAuth (Auth.js) required tables ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain models ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(STUDENT)
  phone        String?
  country      String?
  address      String?
  dateOfBirth  DateTime?
  gender       Gender?   @default(UNSPECIFIED)
  profileImage String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // "You registered but haven't picked a course yet" reminder, for a
  // STUDENT with zero Enrollment rows at all. Same throttling idea as
  // Enrollment.reminderSentAt — null means never sent.
  enrollmentReminderSentAt DateTime?
  enrollmentReminderCount  Int        @default(0)

  // Secret token behind a read-only "parent progress" link the student can
  // create or revoke from their profile. null = no link exists.
  parentShareToken String? @unique

  // Printed on the student ID card and used by its QR verification page
  // (AFZ-S-XXXXXX). Assigned the first time the student opens their card.
  studentNumber String? @unique

  // Student-specific relations
  guardian     Guardian?
  enrollments  Enrollment[]
  payments     Payment[]
  attendance   Attendance[]
  pushSubscriptions PushSubscription[]

  // Sponsor-specific relations
  sponsorProfile SponsorProfile?
  sponsorships   Sponsorship[]

  accounts Account[]
  sessions Session[]

  notifications Notification[]

  @@index([role])
  @@index([email])
}

model Guardian {
  id           String   @id @default(cuid())
  studentId    String   @unique
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
}

model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  shortDescription String
  image            String?
  price            Decimal  @db.Decimal(10, 2)
  currency         String   @default("NGN")
  duration         String
  schedule         String?
  zoomLink         String?
  level            String
  ageGroup         String
  category         String?
  instructorId     String?
  instructor       Teacher? @relation(fields: [instructorId], references: [id])
  curriculum       Json?
  requirements     Json?
  faqs             Json?
  active           Boolean  @default(true)
  enrollmentOpen   Boolean  @default(true)
  // Optional per-course deadline. When set and in the past, enrollment is
  // treated as closed even if enrollmentOpen is still true — the admin
  // doesn't have to remember to flip it off manually.
  registrationClosesAt DateTime?
  // When this cohort's classes actually begin. Set by the admin once a
  // start date is confirmed; leaving it blank just means no commencement
  // notice goes out (e.g. a rolling/self-paced course with no fixed start).
  classStartsAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments Enrollment[]
  payments    Payment[]
  materials   CourseMaterial[]
  sessions    ClassSession[]

  @@index([slug])
  @@index([active])
}

// Admin-uploaded class materials (notes, slides, PDFs) per course. Files are
// hosted externally (Cloudinary) and referenced by URL — same reasoning as
// course/teacher/event images: local files baked into the deployed build
// turned out to be unreliable on Render.
model CourseMaterial {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  uploadedAt  DateTime @default(now())

  @@index([courseId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)
  source     EnrollmentSource @default(PAYSTACK)
  adminNote  String?
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime?

  // null = not graded yet. examResultSeen gates the dashboard pop-up: set
  // false whenever a new result is recorded, flipped true once the student
  // dismisses it, so it shows exactly once per result.
  examResult     ExamResult?
  examResultSeen Boolean     @default(false)

  // Tracks the "complete your payment" reminder email so the cron job (or
  // the admin's manual trigger) doesn't re-send it every run — null means
  // never sent, otherwise the last time one went out, throttled in code.
  reminderSentAt DateTime?
  reminderCount  Int        @default(0)

  // Tracks the "classes start on..." commencement notice so the cron job
  // (or the admin's manual trigger) sends it to each student exactly once
  // per course, regardless of how many times the check runs.
  commencementNotifiedAt DateTime?

  // Set when an admin issues a completion certificate. The number is what
  // appears on the certificate and in its public verification URL.
  certificateNumber   String?   @unique
  certificateIssuedAt DateTime?

  @@unique([studentId, courseId])
  @@index([status])
}

// One dated live class for a course. Reminders, the student schedule and
// attendance all hang off these (Course.schedule stays as free-text info).
model ClassSession {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  durationMinutes Int      @default(60)
  topic           String?
  // Overrides Course.zoomLink for this one class when set.
  zoomLink        String?
  cancelled       Boolean  @default(false)
  // Set once the "class starts soon" reminder has gone out.
  reminderSentAt  DateTime?
  createdAt       DateTime @default(now())

  attendance Attendance[]

  @@index([courseId, startsAt])
  @@index([startsAt])
}

model Attendance {
  id        String               @id @default(cuid())
  sessionId String
  session   ClassSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  markedAt  DateTime             @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           PaymentType
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("NGN")
  reference      String        @unique
  status         PaymentStatus @default(PENDING)
  provider       String        @default("paystack")
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id])
  sponsorshipId  String?
  sponsorship    Sponsorship?  @relation(fields: [sponsorshipId], references: [id])
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([reference])
  @@index([status])
  @@index([userId])
}

model Sponsorship {
  id               String            @id @default(cuid())
  sponsorId        String
  sponsor          User              @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  numberOfStudents Int
  amountPerStudent Decimal           @db.Decimal(10, 2)
  totalAmount      Decimal           @db.Decimal(10, 2)
  currency         String            @default("NGN")
  duration         String
  status           SponsorshipStatus @default(PENDING)
  showPublicly     Boolean           @default(false)
  publicName       String?
  message          String?
  createdAt        DateTime          @default(now())
  expiresAt        DateTime?

  payments Payment[]

  @@index([status])
  @@index([showPublicly])
}

model SponsorProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String?
  publicName       String?
  showPublicly     Boolean @default(false)
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  photo          String?
  qualification  String?
  specialization String?
  biography      String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  courses Course[]
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  country   String?
  content   String   @db.Text
  image     String?
  course    String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Public alumni showcase + directory. "featured" pins a graduate to the top
// of the public page; "published" controls visibility, same pattern as
// Testimonial and Event.
model Alumnus {
  id             String   @id @default(cuid())
  name           String
  photo          String?
  graduationYear Int
  program        String
  currentRole    String?
  location       String?
  story          String   @db.Text
  linkedinUrl    String?
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Self-registration workflow. Admin-created rows default to APPROVED;
  // public submissions start PENDING and unpublished. "email" is private:
  // it is only for admin verification and is never shown publicly.
  status           AlumniStatus @default(APPROVED)
  email            String?
  consentToDisplay Boolean      @default(false)
  selfSubmitted    Boolean      @default(false)

  @@index([status])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  date        DateTime
  time        String
  location    String
  speaker     String?
  image       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// Singleton row (id fixed to "singleton") holding admin-editable global config.
// Section 17/29/64: sponsorship price, currency and contact details must never
// be hardcoded in the frontend.
model SiteSettings {
  id                 String   @id @default("singleton")
  sponsorshipPrice   Decimal  @db.Decimal(10, 2) @default(30000)
  currency           String   @default("NGN")
  currencySymbol     String   @default("₦")
  minSponsorStudents Int      @default(1)
  maxSponsorStudents Int      @default(100)
  whatsappNumber     String?
  contactEmail       String?
  phoneNumber        String?
  facebookUrl        String?
  instagramUrl       String?
  youtubeUrl         String?
  logoUrl            String?
  heroImageUrl       String?
  studentsCount      Int      @default(0)
  countriesCount     Int      @default(0)
  classesDelivered   Int      @default(0)
  // Optional manual bank-transfer details, shown as a fallback next to the
  // Paystack checkout (sponsor page, course page, student dashboard). All
  // blank = the fallback box simply isn't shown.
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankTransferNote   String?
  // Printed on certificates. The signature is an image (URL, e.g. from
  // Cloudinary) of the director's real signature on a plain background.
  directorName         String?
  directorTitle        String?
  directorSignatureUrl String?
  updatedAt          DateTime @updatedAt
}

// In-app notifications (spec section 47). Created server-side when real
// events happen (e.g. a payment is verified) and shown at /dashboard/notifications.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// One row per browser/device a user has turned push notifications on for.
// `endpoint` is the push service address the browser gave us; p256dh/auth
// are the keys needed to encrypt messages to that device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
