// AlFawz Academy — database schema
// Mirrors Section 40 of the project spec, plus the tables NextAuth needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  STUDENT
  SPONSOR
  ADMIN
  SUPER_ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// How an enrollment became ACTIVE. PAYSTACK is the normal self-serve flow.
// The other two are admin-recorded (Section: admin adds students directly)
// — OFFLINE_PAYMENT still creates a real Payment row (counts as revenue,
// money genuinely changed hands, just not through Paystack); SCHOLARSHIP
// creates no Payment row at all, so it never inflates revenue totals.
enum EnrollmentSource {
  PAYSTACK
  SCHOLARSHIP
  OFFLINE_PAYMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum ExamResult {
  PASSED
  FAILED
}

// QUIZ and TEST count toward continuous assessment (CA); EXAM is the final exam.
enum AssessmentKind {
  QUIZ
  TEST
  EXAM
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum PaymentType {
  COURSE
  SPONSORSHIP
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum SponsorshipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AlumniStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  NEW
  READ
  RESOLVED
}

// ---------- NextAuth (Auth.js) required tables ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Core domain models ----------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(STUDENT)
  phone        String?
  country      String?
  address      String?
  dateOfBirth  DateTime?
  gender       Gender?   @default(UNSPECIFIED)
  profileImage String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // "You registered but haven't picked a course yet" reminder, for a
  // STUDENT with zero Enrollment rows at all. Same throttling idea as
  // Enrollment.reminderSentAt — null means never sent.
  enrollmentReminderSentAt DateTime?
  enrollmentReminderCount  Int        @default(0)

  // Secret token behind a read-only "parent progress" link the student can
  // create or revoke from their profile. null = no link exists.
  parentShareToken String? @unique

  // Printed on the student ID card and used by its QR verification page
  // (AFZ-S-XXXXXX). Assigned the first time the student opens their card.
  studentNumber String? @unique

  // Student-specific relations
  guardian     Guardian?
  enrollments  Enrollment[]
  payments     Payment[]
  attendance   Attendance[]
  pushSubscriptions PushSubscription[]
  bankClaims        BankTransferClaim[]
  teacherProfile    Teacher?
  recitationSubmissions RecitationSubmission[]
  chatMessages  CourseMessage[]
  chatMemberships CourseChatMember[]
  sponsorImpact SponsorImpact? @relation("SponsorImpactSponsor")

  // Referral tracking: the code this person arrived through (first touch),
  // and the personal code they can share with friends.
  referralCodeId String?
  referredBy     ReferralCode? @relation("ReferredBy", fields: [referralCodeId], references: [id], onDelete: SetNull)
  ownReferralCode ReferralCode? @relation("ReferralOwner")
  assessmentAttempts    AssessmentAttempt[]
  scholarshipApplications ScholarshipApplication[]

  // Sponsor-specific relations
  sponsorProfile SponsorProfile?
  sponsorships   Sponsorship[]

  accounts Account[]
  sessions Session[]

  notifications Notification[]

  @@index([role])
  @@index([email])
}

model Guardian {
  id           String   @id @default(cuid())
  studentId    String   @unique
  student      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
}

model Course {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  description      String   @db.Text
  shortDescription String
  image            String?
  price            Decimal  @db.Decimal(10, 2)
  currency         String   @default("NGN")
  duration         String
  schedule         String?
  zoomLink         String?
  level            String
  ageGroup         String
  category         String?
  instructorId     String?
  instructor       Teacher? @relation(fields: [instructorId], references: [id])
  curriculum       Json?
  requirements     Json?
  faqs             Json?
  active           Boolean  @default(true)
  enrollmentOpen   Boolean  @default(true)
  // Optional per-course deadline. When set and in the past, enrollment is
  // treated as closed even if enrollmentOpen is still true — the admin
  // doesn't have to remember to flip it off manually.
  registrationClosesAt DateTime?
  // When this cohort's classes actually begin. Set by the admin once a
  // start date is confirmed; leaving it blank just means no commencement
  // notice goes out (e.g. a rolling/self-paced course with no fixed start).
  classStartsAt    DateTime?
  // How the final result is worked out (percent weights of continuous
  // assessment and the exam, and the pass mark out of 100).
  caWeight         Int      @default(40)
  examWeight       Int      @default(60)
  passMark         Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assessments Assessment[]
  enrollments Enrollment[]
  payments    Payment[]
  materials   CourseMaterial[]
  sessions    ClassSession[]
  announcements Announcement[]
  recitationTasks RecitationTask[]
  bankClaims    BankTransferClaim[]
  scholarshipApplications ScholarshipApplication[]
  chatMessages  CourseMessage[]
  chatMembers   CourseChatMember[]

  @@index([slug])
  @@index([active])
}

// Admin-uploaded class materials (notes, slides, PDFs) per course. Files are
// hosted externally (Cloudinary) and referenced by URL — same reasoning as
// course/teacher/event images: local files baked into the deployed build
// turned out to be unreliable on Render.
model CourseMaterial {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  uploadedAt  DateTime @default(now())

  @@index([courseId])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(PENDING)
  source     EnrollmentSource @default(PAYSTACK)
  adminNote  String?
  enrolledAt DateTime         @default(now())
  expiresAt  DateTime?

  // null = not graded yet. examResultSeen gates the dashboard pop-up: set
  // false whenever a new result is recorded, flipped true once the student
  // dismisses it, so it shows exactly once per result.
  examResult     ExamResult?
  examResultSeen Boolean     @default(false)
  // Final percentage (0-100) recorded when the teacher publishes results.
  finalScore     Float?

  // Tracks the "complete your payment" reminder email so the cron job (or
  // the admin's manual trigger) doesn't re-send it every run — null means
  // never sent, otherwise the last time one went out, throttled in code.
  reminderSentAt DateTime?
  reminderCount  Int        @default(0)

  // Tracks the "classes start on..." commencement notice so the cron job
  // (or the admin's manual trigger) sends it to each student exactly once
  // per course, regardless of how many times the check runs.
  commencementNotifiedAt DateTime?

  // Set when an admin issues a completion certificate. The number is what
  // appears on the certificate and in its public verification URL.
  certificateNumber   String?   @unique
  certificateIssuedAt DateTime?

  @@unique([studentId, courseId])
  @@index([status])
}

// One dated live class for a course. Reminders, the student schedule and
// attendance all hang off these (Course.schedule stays as free-text info).
model ClassSession {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  durationMinutes Int      @default(60)
  topic           String?
  // Overrides Course.zoomLink for this one class when set.
  zoomLink        String?
  cancelled       Boolean  @default(false)
  // Link to the Zoom/Drive recording, added after the class so absent students can catch up.
  recordingUrl    String?
  // Set once the "class starts soon" reminder has gone out.
  reminderSentAt  DateTime?
  createdAt       DateTime @default(now())

  attendance Attendance[]

  @@index([courseId, startsAt])
  @@index([startsAt])
}

model Attendance {
  id        String               @id @default(cuid())
  sessionId String
  session   ClassSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  markedAt  DateTime             @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           PaymentType
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("NGN")
  reference      String        @unique
  status         PaymentStatus @default(PENDING)
  provider       String        @default("paystack")
  courseId       String?
  course         Course?       @relation(fields: [courseId], references: [id])
  sponsorshipId  String?
  sponsorship    Sponsorship?  @relation(fields: [sponsorshipId], references: [id])
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([reference])
  @@index([status])
  @@index([userId])
}

model Sponsorship {
  id               String            @id @default(cuid())
  sponsorId        String
  sponsor          User              @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  numberOfStudents Int
  amountPerStudent Decimal           @db.Decimal(10, 2)
  totalAmount      Decimal           @db.Decimal(10, 2)
  currency         String            @default("NGN")
  duration         String
  status           SponsorshipStatus @default(PENDING)
  showPublicly     Boolean           @default(false)
  publicName       String?
  message          String?
  createdAt        DateTime          @default(now())
  expiresAt        DateTime?

  payments Payment[]

  @@index([status])
  @@index([showPublicly])
}

model SponsorProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String?
  publicName       String?
  showPublicly     Boolean @default(false)
}

model Teacher {
  id             String   @id @default(cuid())
  name           String
  photo          String?
  qualification  String?
  specialization String?
  biography      String?  @db.Text
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  // Optional login account (role TEACHER) so the teacher can sign in to /teacher.
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  courses Course[]
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  country   String?
  content   String   @db.Text
  image     String?
  course    String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Public alumni showcase + directory. "featured" pins a graduate to the top
// of the public page; "published" controls visibility, same pattern as
// Testimonial and Event.
model Alumnus {
  id             String   @id @default(cuid())
  name           String
  photo          String?
  graduationYear Int
  program        String
  currentRole    String?
  location       String?
  story          String   @db.Text
  linkedinUrl    String?
  featured       Boolean  @default(false)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Self-registration workflow. Admin-created rows default to APPROVED;
  // public submissions start PENDING and unpublished. "email" is private:
  // it is only for admin verification and is never shown publicly.
  status           AlumniStatus @default(APPROVED)
  email            String?
  consentToDisplay Boolean      @default(false)
  selfSubmitted    Boolean      @default(false)

  @@index([status])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  date        DateTime
  time        String
  location    String
  speaker     String?
  image       String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// Singleton row (id fixed to "singleton") holding admin-editable global config.
// Section 17/29/64: sponsorship price, currency and contact details must never
// be hardcoded in the frontend.
model SiteSettings {
  id                 String   @id @default("singleton")
  sponsorshipPrice   Decimal  @db.Decimal(10, 2) @default(30000)
  currency           String   @default("NGN")
  currencySymbol     String   @default("₦")
  minSponsorStudents Int      @default(1)
  maxSponsorStudents Int      @default(100)
  whatsappNumber     String?
  contactEmail       String?
  phoneNumber        String?
  facebookUrl        String?
  instagramUrl       String?
  youtubeUrl         String?
  logoUrl            String?
  heroImageUrl       String?
  studentsCount      Int      @default(0)
  countriesCount     Int      @default(0)
  classesDelivered   Int      @default(0)
  // Optional manual bank-transfer details, shown as a fallback next to the
  // Paystack checkout (sponsor page, course page, student dashboard). All
  // blank = the fallback box simply isn't shown.
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankTransferNote   String?
  // Printed on certificates. The signature is an image (URL, e.g. from
  // Cloudinary) of the director's real signature on a plain background.
  directorName         String?
  directorTitle        String?
  directorSignatureUrl String?
  updatedAt          DateTime @updatedAt
}

// In-app notifications (spec section 47). Created server-side when real
// events happen (e.g. a payment is verified) and shown at /dashboard/notifications.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// One row per browser/device a user has turned push notifications on for.
// `endpoint` is the push service address the browser gave us; p256dh/auth
// are the keys needed to encrypt messages to that device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// A message an admin sent to a course's students (or everyone). Kept as a
// history; delivery itself goes out as in-app notification + push + email.
model Announcement {
  id         String   @id @default(cuid())
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title      String
  message    String   @db.Text
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// "I've paid by bank transfer" — a student's claim with an optional receipt.
// An admin checks the bank account, then approves (which enrols the student
// and records a payment) or rejects with a reason.
model BankTransferClaim {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  senderName   String
  amount       Decimal           @db.Decimal(10, 2)
  paidOn       DateTime?
  receiptUrl   String?
  note         String?
  status       ApplicationStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
  @@index([studentId])
}

model ScholarshipApplication {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reason       String            @db.Text
  status       ApplicationStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
  @@index([studentId])
}

// A recitation exercise a teacher sets for a course ("Recite Surah An-Naba 1-10").
model RecitationTask {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  instructions String?  @db.Text
  dueAt        DateTime?
  createdAt    DateTime @default(now())

  submissions RecitationSubmission[]

  @@index([courseId, createdAt])
}

// A student's audio recording for a task, plus the teacher's feedback.
// One per student per task: sending again replaces the recording.
model RecitationSubmission {
  id          String         @id @default(cuid())
  taskId      String
  task        RecitationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  audioUrl    String
  durationSec Int?
  note        String?
  submittedAt DateTime       @default(now())
  // Review (null until a teacher has listened)
  rating      Int?
  feedback    String?        @db.Text
  // Optional spoken feedback from the teacher (Cloudinary URL).
  feedbackAudioUrl String?
  feedbackAudioSec Int?
  reviewedAt  DateTime?
  reviewedById String?

  @@unique([taskId, studentId])
  @@index([taskId, reviewedAt])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Examinations and continuous assessment
// ---------------------------------------------------------------------------

model Assessment {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  instructions     String?          @db.Text
  kind             AssessmentKind   @default(QUIZ)
  status           AssessmentStatus @default(DRAFT)
  durationMinutes  Int              @default(30)
  // Optional window in which students may start it.
  opensAt          DateTime?
  closesAt         DateTime?
  shuffleQuestions Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@index([courseId, status])
}

model AssessmentQuestion {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  position     Int          @default(0)
  type         QuestionType
  prompt       String       @db.Text
  // MULTIPLE_CHOICE: the list of choices (JSON array of strings).
  options      Json?
  // MULTIPLE_CHOICE: index of the right choice ("0", "1", ...). TRUE_FALSE:
  // "true" or "false". SHORT_ANSWER: accepted answers separated by "|"
  // (blank = marked by hand). LONG_ANSWER: unused.
  correct      String?
  points       Int          @default(1)

  answers AssessmentAnswer[]

  @@index([assessmentId, position])
}

// A student's single attempt at an assessment.
model AssessmentAttempt {
  id           String        @id @default(cuid())
  assessmentId String
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt    DateTime      @default(now())
  // Hard stop: start + duration, never later than the assessment's closing time.
  deadlineAt   DateTime
  submittedAt  DateTime?
  status       AttemptStatus @default(IN_PROGRESS)
  // Points awarded so far (auto-marked + hand-marked), and the most available.
  score        Int           @default(0)
  maxScore     Int           @default(0)
  // True while some answers still wait for a teacher's mark.
  needsMarking Boolean       @default(false)
  gradedAt     DateTime?

  answers AssessmentAnswer[]

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([assessmentId, status])
}

model AssessmentAnswer {
  id         String             @id @default(cuid())
  attemptId  String
  attempt    AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  response   String?            @db.Text
  // null = not marked yet.
  score      Int?
  feedback   String?            @db.Text

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// Figures the admin chooses to show sponsors. A blank (null) field means
// "use the automatic figure"; a number replaces it.
model SponsorImpactSettings {
  id                  String   @id @default("singleton")
  supportedOverride   Int?
  completedOverride   Int?
  certificatesOverride Int?
  attendanceOverride  Int?
  recitationOverride  Float?
  passRateOverride    Int?
  note                String?  @db.Text
  updatedAt           DateTime @updatedAt
}

// Per-sponsor impact figures. Layered over the fund-wide SponsorImpactSettings:
// a blank (null) field falls back to the fund-wide figure, then the automatic one.
model SponsorImpact {
  id                   String   @id @default(cuid())
  sponsorId            String   @unique
  sponsor              User     @relation("SponsorImpactSponsor", fields: [sponsorId], references: [id], onDelete: Cascade)
  supportedOverride    Int?
  completedOverride    Int?
  certificatesOverride Int?
  attendanceOverride   Int?
  recitationOverride   Float?
  passRateOverride     Int?
  note                 String?  @db.Text
  updatedAt            DateTime @updatedAt
}

// A trackable sign-up link (/r/CODE). Either a campaign code the admin creates
// (ownerId null, e.g. "WhatsApp group") or a student's personal invite code.
model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  ownerId   String?  @unique
  owner     User?    @relation("ReferralOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  referredUsers User[] @relation("ReferredBy")
}

// ---------------------------------------------------------------------------
// Course group chat
// ---------------------------------------------------------------------------

// One message in a course's group chat: text, a voice note (Cloudinary URL), or
// both. Deleting is soft (deletedAt) so a moderator's removal is reversible.
model CourseMessage {
  id          String    @id @default(cuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body        String?   @db.Text
  audioUrl    String?
  durationSec Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([courseId, createdAt])
}

// Per person, per course: when they last read the chat (drives the unread
// counter) and whether a teacher/admin has muted them there.
model CourseChatMember {
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())
  muted      Boolean  @default(false)

  @@id([courseId, userId])
  @@index([userId])
}
