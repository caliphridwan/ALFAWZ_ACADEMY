# settings (e.g. Vercel Project Settings > Environment Variables) —
# never paste them into chat, source control, or shared docs.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Email (Resend) ---
EMAIL_API_KEY=""
